    "make:loader": "powershell -ExecutionPolicy Bypass -File scripts/make-loader.ps1"
  },
  "dependencies": {
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
